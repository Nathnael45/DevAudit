# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://devaudit:change-me@localhost:5432/devaudit

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production

# Shared secret between api and worker for POST /internal/broadcast — the API's
# port is reachable from the browser too, so this route can't trust network
# placement alone. Generate with: openssl rand -base64 32
INTERNAL_SECRET=change-me-in-production

# App
API_URL=http://localhost:3001

# Baked into the web bundle at build time (see Dockerfile) — leave these
# BLANK to auto-detect same-host-different-port at runtime, which is what
# lets the demo keep working across EC2 IP changes without a rebuild. Only
# set explicit values if api and web are deployed on different hostnames
# (e.g. separate Fly.io/Render services).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# The API restricts CORS to exactly this origin — set it to wherever the web
# app is actually served (e.g. http://your-ec2-ip:3000), not just the local
# default, or the browser will be blocked from calling the API.
WEB_URL=http://localhost:3000