# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://devaudit:change-me@localhost:5432/devaudit

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production

# Shared secret between api and worker for POST /internal/broadcast — the API's
# port is reachable from the browser too, so this route can't trust network
# placement alone. Generate with: openssl rand -base64 32
INTERNAL_SECRET=change-me-in-production

# App
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001